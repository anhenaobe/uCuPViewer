[Unit]
Description=uCuPViewer local backend
After=network.target

[Service]
Type=simple
User=ucupviewer
Group=ucupviewer
WorkingDirectory=/opt/ucupviewer/backend
EnvironmentFile=-/etc/ucupviewer/backend.env
Environment=UCUPVIEWER_BACKEND_HOST=127.0.0.1
Environment=UCUPVIEWER_BACKEND_PORT=5000
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/ucupviewer/backend/main.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
